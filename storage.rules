rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.get('admin', false) == true ||
        request.auth.token.get('role', '') == 'admin'
      );
    }

    // Production Cloud Storage giới hạn tối đa 2 lệnh gọi Firestore (firestore.get / firestore.exists)
    // trên mỗi request. Mọi rule bên dưới được thiết kế nghiêm ngặt <= 2 Firestore calls.
    function notDeleting(uid) {
      return !firestore.exists(/databases/(default)/documents/pendingDeletions/$(uid));
    }

    function isApprovedVerification(uid) {
      return isAdmin() ||
        firestore.get(/databases/(default)/documents/verifications/$(uid)).data.status == 'approved';
    }

    function isValidImage(maxBytes) {
      return request.resource.contentType.matches('image/(jpeg|webp)') &&
             request.resource.size <= maxBytes;
    }

    function hasSessionMeta() {
      return request.resource.metadata != null &&
        request.resource.metadata.get('sessionId', '').matches('[A-Za-z0-9_-]{8,64}');
    }

    // Cho phép status in ['pending', 'finalized'] để hỗ trợ tải nhiều ảnh trong cùng draft session
    // (claimed phải vẫn == false, expiresAt > request.time và path nằm trong allowedPaths).
    function sessionMatches(sessionData, kind, expectedPath) {
      return sessionData.ownerUid == request.auth.uid &&
        sessionData.kind == kind &&
        sessionData.status in ['pending', 'finalized'] &&
        sessionData.claimed == false &&
        sessionData.expiresAt > request.time &&
        expectedPath in sessionData.allowedPaths;
    }

    // Chỉ dùng đúng 1 lệnh firestore.get() (tự động fail-closed nếu doc không tồn tại)
    function hasValidUploadSession(kind, expectedPath) {
      return hasSessionMeta() &&
        sessionMatches(
          firestore.get(/databases/(default)/documents/uploadSessions/$(request.resource.metadata.sessionId)).data,
          kind,
          expectedPath
        );
    }

    function isActiveChatParticipant(convData) {
      return request.auth.uid in convData.participantIds &&
        convData.get('status', 'active') == 'active' &&
        (
          convData.get('blockedBy', null) == null ||
          (convData.blockedBy is map && convData.blockedBy.get(request.auth.uid, false) != true)
        );
    }

    // 1. Ảnh thẻ sinh viên: tối đa 2 Firestore calls (pendingDeletions + uploadSessions)
    match /private/cards/{userId}/{fileName} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && isValidImage(10 * 1024 * 1024)
        && fileName.matches('[A-Za-z0-9_-]{4,64}\\.(webp|jpg)')
        && notDeleting(userId)
        && hasValidUploadSession('card', 'private/cards/' + userId + '/' + fileName);
      allow update: if false;
      // Tối đa 2 Firestore docs (pendingDeletions + verifications)
      allow delete: if isAdmin() || (
        isOwner(userId) &&
        notDeleting(userId) &&
        firestore.get(/databases/(default)/documents/verifications/$(userId)).data.status == 'rejected'
      );
    }

    // 2. Ảnh tin đăng: tối đa 2 Firestore calls (verifications + uploadSessions)
    // Trạng thái active/deleting của tài khoản đã được /api/uploads/intent kiểm tra và account/delete vô hiệu hóa session.
    match /public/listings/{userId}/{draftId}/{fileName} {
      allow read: if true;
      allow create: if isOwner(userId)
        && isValidImage(5 * 1024 * 1024)
        && fileName.matches('[A-Za-z0-9_-]{4,64}\\.(webp|jpg)')
        && isApprovedVerification(userId)
        && hasValidUploadSession('listing', 'public/listings/' + userId + '/' + draftId + '/' + fileName);
      allow update: if false;
      allow delete: if isAdmin() || (
        isOwner(userId) &&
        notDeleting(userId) &&
        isApprovedVerification(userId)
      );
    }

    // 3. Ảnh đại diện người dùng: hỗ trợ cả .webp và .jpg (cho Safari iOS/iPadOS), tối đa 2 Firestore calls
    match /public/avatars/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if isOwner(userId)
        && isValidImage(2 * 1024 * 1024)
        && fileName.matches('avatar\\.(webp|jpg)')
        && isApprovedVerification(userId)
        && hasValidUploadSession('avatar', 'public/avatars/' + userId + '/' + fileName);
      allow delete: if isAdmin() || (
        isOwner(userId) &&
        notDeleting(userId) &&
        isApprovedVerification(userId)
      );
    }

    // 4. Ảnh đính kèm chat:
    // - read: tối đa 2 Firestore calls (pendingDeletions + conversations)
    // - create: tối đa 2 Firestore calls (conversations + uploadSessions; /api/uploads/intent đã kiểm tra live verified + active account)
    match /private/chats/{chatId}/{fileName} {
      allow read: if isAuthenticated() && (
        isAdmin() || (
          notDeleting(request.auth.uid) &&
          request.auth.uid in firestore.get(/databases/(default)/documents/conversations/$(chatId)).data.participantIds
        )
      );
      allow create: if isAuthenticated()
        && isValidImage(3 * 1024 * 1024)
        && fileName.matches('[A-Za-z0-9_-]{8,64}\\.(webp|jpg)')
        && isActiveChatParticipant(firestore.get(/databases/(default)/documents/conversations/$(chatId)).data)
        && hasValidUploadSession('chat', 'private/chats/' + chatId + '/' + fileName);
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Default deny all others
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
