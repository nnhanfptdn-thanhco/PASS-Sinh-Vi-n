rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.get('admin', false) == true ||
        request.auth.token.get('role', '') == 'admin'
      );
    }

    function isVerified() {
      return isAuthenticated() && (
        request.auth.token.get('verified', false) == true ||
        request.auth.token.get('studentVerified', false) == true ||
        request.auth.token.get('role', '') == 'verified' ||
        isAdmin()
      );
    }

    function isValidImage(maxBytes) {
      return request.resource.contentType.matches('image/(jpeg|png|webp)') &&
             request.resource.size <= maxBytes;
    }

    // 1. Ảnh thẻ sinh viên (BẢO MẬT & RIÊNG TƯ TUYỆT ĐỐI)
    // Chỉ tạo mới (không update đè), tên file theo mẫu, tối đa 10MB
    // Xóa cho phép Admin hoặc chủ sở hữu khi chưa nộp hồ sơ hoặc hồ sơ bị từ chối
    match /private/cards/{userId}/{fileName} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidImage(10 * 1024 * 1024) && fileName.matches('[A-Za-z0-9_-]{4,64}\\.(webp|jpg)');
      allow update: if false;
      allow delete: if isAdmin() || (isOwner(userId) && (
        !firestore.exists(/databases/(default)/documents/verifications/$(userId)) ||
        firestore.get(/databases/(default)/documents/verifications/$(userId)).data.status == 'rejected'
      ));
    }

    // 2. Ảnh tin đăng bán đồ: Quy ước mới (public/listings/{userId}/{draftId}/{fileName})
    // Công khai đọc; chỉ chủ tài khoản đã xác minh mới được tạo ảnh; cấm update; xóa bởi chủ hoặc Admin
    match /public/listings/{userId}/{draftId}/{fileName} {
      allow read: if true;
      allow create: if isOwner(userId) && isVerified()
        && isValidImage(5 * 1024 * 1024)
        && fileName.matches('[A-Za-z0-9_-]{4,64}\\.(webp|jpg)');
      allow update: if false;
      allow delete: if isAdmin() || (isOwner(userId) && isVerified());
    }

    // 3. Ảnh đại diện người dùng: Tên file cố định avatar.webp, tối đa 2MB, chỉ chủ tài khoản đã xác minh
    match /public/avatars/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if isOwner(userId) && isVerified() && isValidImage(2 * 1024 * 1024) && fileName == 'avatar.webp';
      allow delete: if (isOwner(userId) && isVerified()) || isAdmin();
    }

    // 4. Ảnh đính kèm trong tin nhắn chat: ≤3MB, tên file đúng mẫu, cấm update, chỉ xóa bởi Admin
    match /private/chats/{chatId}/{fileName} {
      allow read: if isAuthenticated() && (
        request.auth.uid in firestore.get(/databases/(default)/documents/conversations/$(chatId)).data.participantIds ||
        isAdmin()
      );
      allow create: if isAuthenticated() && isValidImage(3 * 1024 * 1024) &&
        fileName.matches('[A-Za-z0-9_-]{8,64}\\.(webp|jpg)') &&
        request.auth.uid in firestore.get(/databases/(default)/documents/conversations/$(chatId)).data.participantIds;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Default deny all others
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
