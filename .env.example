# Firebase Client Config (Công khai)
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-cho-pass-sv.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=cho-pass-sv-dev
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=cho-pass-sv-dev.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# Cờ sử dụng Firebase Emulator cho Local Dev
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true
NEXT_PUBLIC_EMULATOR_AUTH_URL=http://127.0.0.1:9099
NEXT_PUBLIC_EMULATOR_FIRESTORE_HOST=127.0.0.1
NEXT_PUBLIC_EMULATOR_FIRESTORE_PORT=8080
NEXT_PUBLIC_EMULATOR_STORAGE_HOST=127.0.0.1
NEXT_PUBLIC_EMULATOR_STORAGE_PORT=9199

# Firebase Admin SDK (Chỉ Server / Functions)
FIREBASE_PROJECT_ID=cho-pass-sv-dev
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@cho-pass-sv-dev.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=""

# Email Service (Resend hoặc Nodemailer SMTP)
EMAIL_SERVICE_PROVIDER=console # "resend" | "smtp" | "console"
RESEND_API_KEY=""
EMAIL_FROM="Chợ Pass Sinh Viên <noreply@chopass.vn>"
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""

# Bảo mật & Mã băm MSSV (Secret Manager / Server only)
STUDENT_ID_HMAC_SECRET="demo-secret-key-replace-in-production"

# Email Admin khởi tạo ban đầu (Tự động cấp quyền quản trị viên khi đăng nhập)
ADMIN_EMAIL="admin@chopass.vn"
