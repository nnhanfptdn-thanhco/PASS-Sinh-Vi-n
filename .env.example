# ==============================================================================
# CẤU HÌNH MÔI TRƯỜNG: CHỢ PASS SINH VIÊN (CHO-PASS-SV)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FIREBASE CLIENT CONFIG (Công khai phía trình duyệt)
# Lấy từ: Firebase Console -> Project Settings -> General -> Your apps -> Web app
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# ------------------------------------------------------------------------------
# 2. LOCAL DEV: FIREBASE EMULATOR SUITE
# Bật 'true' khi chạy emulator cục bộ. Bắt buộc 'false' trên Production (Vercel)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false
NEXT_PUBLIC_EMULATOR_AUTH_URL=http://127.0.0.1:9099
NEXT_PUBLIC_EMULATOR_FIRESTORE_HOST=127.0.0.1
NEXT_PUBLIC_EMULATOR_FIRESTORE_PORT=8080
NEXT_PUBLIC_EMULATOR_STORAGE_HOST=127.0.0.1
NEXT_PUBLIC_EMULATOR_STORAGE_PORT=9199

# ------------------------------------------------------------------------------
# 3. FIREBASE ADMIN SDK (SERVER-ONLY - BẢO MẬT TUYỆT ĐỐI)
# Lấy từ: Firebase Console -> Project Settings -> Service accounts -> Generate new private key
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
# Lưu ý: Giữ nguyên các ký tự \n trong chuỗi private key
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com

# ------------------------------------------------------------------------------
# 4. MÃ BĂM HMAC-SHA256 CHO MÃ SỐ SINH VIÊN (BẮT BUỘC TRÊN PRODUCTION, >= 32 KÝ TỰ)
# Chuỗi ngẫu nhiên dài từ 32 - 64 ký tự (ví dụ tạo bằng: openssl rand -hex 32)
# Tuyệt đối không dùng chuỗi mặc định trên môi trường Production!
# ------------------------------------------------------------------------------
STUDENT_ID_HMAC_SECRET=your_super_strong_random_hmac_secret_key_minimum_32_characters

# ------------------------------------------------------------------------------
# 5. DANH SÁCH EMAIL QUẢN TRỊ VIÊN (BẮT BUỘC ĐỂ CẤP ADMIN TOKEN)
# Phân tách nhiều email bằng dấu phẩy
# ------------------------------------------------------------------------------
ADMIN_EMAILS="admin@chopass.vn,nnhanfptdn@gmail.com"

# ------------------------------------------------------------------------------
# 6. CRON JOB SECURITY (BẮT BUỘC ĐỂ BẢO VỆ CÁC ROUTE CRON)
# Khóa bí mật bảo vệ endpoint /api/cron/cleanup và /api/cron/purge-cards khi gọi từ Vercel Cron
# ------------------------------------------------------------------------------
CRON_SECRET=your_super_strong_random_cron_secret_token_here

# ------------------------------------------------------------------------------
# 7. DỊCH VỤ EMAIL
# ------------------------------------------------------------------------------
EMAIL_SERVICE_PROVIDER=console # "resend" | "smtp" | "console"
RESEND_API_KEY=""
EMAIL_FROM="Chợ Pass Sinh Viên <noreply@chopass.vn>"
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
