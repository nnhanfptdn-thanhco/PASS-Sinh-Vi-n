rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.get('admin', false) == true ||
        request.auth.token.get('role', '') == 'admin'
      );
    }

    // Kiểm tra trạng thái tài khoản trên Firestore: không đang chờ xóa / không bị khóa / cấm
    function isUserDocActive(d) {
      return d.get('accountStatus', 'active') == 'active' &&
        d.get('status', 'active') == 'active' &&
        d.get('disabled', false) != true &&
        d.get('deleted', false) != true &&
        !(d.get('deletionState', '') in ['pending', 'deleting', 'deleted']);
    }

    function isActiveAccount() {
      return isAuthenticated() &&
        !exists(/databases/$(database)/documents/pendingDeletions/$(request.auth.uid)) &&
        (
          !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
          isUserDocActive(get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
        );
    }

    // Nguồn chân lý sinh viên đã duyệt dựa trực tiếp trên Firestore (không dùng legacy studentVerified claim)
    function isVerified() {
      return isActiveAccount() && (
        isAdmin() ||
        (
          exists(/databases/$(database)/documents/verifications/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/verifications/$(request.auth.uid)).data.status == 'approved'
        )
      );
    }

    // 1. users: Đọc công khai profile; tạo/xóa qua Server API; update chỉ photoURL khi tài khoản active
    match /users/{userId} {
      allow read: if true;
      allow create: if false; // Tạo bởi server API bootstrap
      allow update: if (isOwner(userId)
          && isActiveAccount()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photoURL', 'updatedAt'])
          && (
            request.resource.data.get('photoURL', null) == null || (
              request.resource.data.photoURL is string &&
              request.resource.data.photoURL.size() <= 500 &&
              (
                request.resource.data.photoURL.matches('https://lh3\\.googleusercontent\\.com/.*') ||
                request.resource.data.photoURL.matches('https://firebasestorage\\.googleapis\\.com/v0/b/cho-pass-sv(-dev)?\\.(firebasestorage\\.app|appspot\\.com)/o/public%2Favatars%2F' + userId + '%2Favatar\\.(webp|jpg)(\\?.*)?')
              )
            )
          ))
        || isAdmin();
      allow delete: if false; // Xóa qua server API account/delete
    }

    // 2. usersPrivate: Chỉ chủ sở hữu và Admin đọc; ghi chỉ qua server Admin SDK
    match /usersPrivate/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
    }

    // 3. verifications: Chủ tài khoản và Admin đọc; mọi ghi/duyệt qua Server API
    match /verifications/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
    }

    // 4. regions & schools & categories (Danh mục hành chính & trường học)
    match /regions/{regionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /schools/{schoolCode} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{catId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 5. listings: Công khai active/reserved; chủ tin và Admin đọc thêm các trạng thái khác; ghi Server-only
    match /listings/{listingId} {
      allow read: if resource.data.status in ['active', 'reserved']
                  || (isAuthenticated() && resource.data.sellerId == request.auth.uid)
                  || isAdmin();
      allow write: if false;
    }

    // 6. listingsPrivate: OPTION A — Cấm buyer đọc trực tiếp qua SDK; chỉ chủ tin hoặc Admin đọc; buyer qua /api/listings/contact
    match /listingsPrivate/{listingId} {
      allow read: if isAuthenticated() && (
        resource.data.sellerId == request.auth.uid ||
        isAdmin()
      );
      allow write: if false;
    }

    // 7. reservations (Giữ chỗ): Mọi ghi qua Server API
    match /reservations/{reservationId} {
      allow read: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        isAdmin()
      );
      allow write: if false;
    }

    // 8. conversations & messages: Đọc bởi thành viên đang active (hoặc Admin); MỌI GHI Server-only qua API
    match /conversations/{convId} {
      allow read: if isActiveAccount() && (
        request.auth.uid in resource.data.participantIds ||
        isAdmin()
      );
      allow create, update, delete: if false;
    }

    match /conversations/{convId}/messages/{msgId} {
      allow read: if isActiveAccount() &&
        exists(/databases/$(database)/documents/conversations/$(convId)) &&
        (
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds ||
          isAdmin()
        );
      allow create, update, delete: if false;
    }

    // 8b. aiConversations (NnhanAI): Tách biệt hoàn toàn khỏi chat buyer/seller; chỉ owner đang active đọc; mọi ghi Server-only
    match /aiConversations/{convId} {
      allow read: if isActiveAccount() && resource.data.ownerUid == request.auth.uid;
      allow write: if false;
    }

    match /aiConversations/{convId}/messages/{msgId} {
      allow read: if isActiveAccount() &&
        exists(/databases/$(database)/documents/aiConversations/$(convId)) &&
        get(/databases/$(database)/documents/aiConversations/$(convId)).data.ownerUid == request.auth.uid;
      allow write: if false;
    }

    // 9. favorites & follows: Ghi duy nhất qua Server API
    match /favorites/{favId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    match /follows/{followId} {
      allow read: if isAuthenticated() && (resource.data.followerId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // 10. reviews: Ghi qua Server API
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if false;
    }

    // 11. reports & appeals: Ghi qua Server API
    match /reports/{reportId} {
      allow read: if (isAuthenticated() && resource.data.reporterId == request.auth.uid) || isAdmin();
      allow write: if false;
    }

    match /appeals/{appealId} {
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      allow write: if false;
    }

    // 12. notifications: Tạo Server-only; người dùng active chỉ update trạng thái read hoặc tự xóa
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if false;
      allow update: if isActiveAccount() && resource.data.userId == request.auth.uid &&
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'updatedAt']);
      allow delete: if isActiveAccount() && resource.data.userId == request.auth.uid;
    }

    // 13. adminLogs & contactViewLogs: Chỉ Admin đọc, Server ghi
    match /adminLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /contactViewLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // 14. Internal server queues, locks, quotas & state (Cấm hoàn toàn truy cập client)
    match /uploadSessions/{id} { allow read, write: if false; }
    match /userUploadQuotas/{id} { allow read, write: if false; }
    match /userAiQuotas/{id} { allow read, write: if false; }
    match /claimsSyncJobs/{id} { allow read, write: if false; }
    match /storageCleanupJobs/{id} { allow read, write: if false; }
    match /listingOperationJobs/{id} { allow read, write: if false; }
    match /deadLetterAlerts/{id} { allow read, write: if false; }
    match /sellerListingStats/{id} { allow read, write: if false; }
    match /sellerTitleLocks/{id} { allow read, write: if false; }
    match /listingReservationStats/{id} { allow read, write: if false; }
    match /userReservationStats/{id} { allow read, write: if false; }
    match /activeReservationLocks/{id} { allow read, write: if false; }
    match /appealPendingLocks/{id} { allow read, write: if false; }
    match /pendingDeletions/{id} { allow read, write: if false; }
    match /rateLimits/{id} { allow read, write: if false; }
    match /idempotency/{id} { allow read, write: if false; }
    match /systemState/{id} { allow read, write: if false; }
    match /systemMeta/{id} { allow read, write: if false; }
    match /studentIdHashes/{id} { allow read, write: if false; }

    // Default deny all others
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
