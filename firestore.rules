rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isVerified() {
      return isAuthenticated() && request.auth.token.verified == true;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin'
      );
    }

    // 1. users: Công khai trường an toàn, chỉ chủ tài khoản ghi
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // 2. usersPrivate: Chỉ chủ sở hữu và Admin đọc/ghi
    match /usersPrivate/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // 3. verifications: Người dùng đọc hồ sơ của mình; Admin duyệt
    match /verifications/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update, delete: if isAdmin();
    }

    // 4. regions & schools & categories (Danh mục hành chính & trường học)
    match /regions/{regionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /schools/{schoolCode} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{catId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 5. listings: Đọc công khai tin đang bán, giữ chỗ hoặc đã bán; chỉ SV đã xác minh được tạo tin
    match /listings/{listingId} {
      allow read: if resource.data.status in ['active', 'reserved', 'sold'] 
                  || (isAuthenticated() && resource.data.sellerId == request.auth.uid)
                  || isAdmin();
      allow create: if isVerified() && request.resource.data.sellerId == request.auth.uid;
      allow update: if (isAuthenticated() && resource.data.sellerId == request.auth.uid) || isAdmin();
      allow delete: if (isAuthenticated() && resource.data.sellerId == request.auth.uid) || isAdmin();
    }

    // 6. listingsPrivate: Chỉ người bán và người mua đã chốt đọc được địa chỉ chính xác
    match /listingsPrivate/{listingId} {
      allow read: if isAuthenticated() && (
        resource.data.sellerId == request.auth.uid ||
        resource.data.confirmedBuyerId == request.auth.uid ||
        isAdmin()
      );
      allow write: if isAuthenticated() && (
        resource.data.sellerId == request.auth.uid ||
        isAdmin()
      );
    }

    // 7. reservations (Giữ chỗ)
    match /reservations/{reservationId} {
      allow read: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isVerified() && request.resource.data.buyerId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        isAdmin()
      );
    }

    // 8. conversations & messages
    match /conversations/{convId} {
      allow read, write: if isAuthenticated() && (
        request.auth.uid in resource.data.participantIds ||
        request.auth.uid in request.resource.data.participantIds ||
        isAdmin()
      );
    }

    match /conversations/{convId}/messages/{msgId} {
      allow read: if isAuthenticated() && (
        request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds ||
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds &&
        request.resource.data.senderId == request.auth.uid
      );
    }

    // 9. favorites & follows
    match /favorites/{favId} {
      allow read, write: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
    }

    match /follows/{followId} {
      allow read, write: if isAuthenticated() && request.auth.uid == resource.data.followerId;
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.followerId;
    }

    // 10. reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isVerified() && (
        request.resource.data.reviewerId == request.auth.uid
      );
    }

    // 11. reports & appeals
    match /reports/{reportId} {
      allow create: if isAuthenticated() && request.resource.data.reporterId == request.auth.uid;
      allow read: if (isAuthenticated() && resource.data.reporterId == request.auth.uid) || isAdmin();
      allow update, delete: if isAdmin();
    }

    match /appeals/{appealId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      allow update, delete: if isAdmin();
    }

    // 12. notifications
    match /notifications/{notifId} {
      allow read, update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
    }

    // 13. adminLogs: Chỉ Admin đọc, Server ghi
    match /adminLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Chỉ qua Admin SDK phía server
    }

    // Default deny all others
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
